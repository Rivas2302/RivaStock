{
  "name": "rivastock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-tesseract-assets.mjs && node scripts/package-facebook-extension.mjs && node scripts/package-ai-bridge.mjs",
    "prebuild": "node scripts/check-no-secrets.mjs && node scripts/copy-tesseract-assets.mjs && node scripts/package-facebook-extension.mjs && node scripts/package-ai-bridge.mjs",
    "package:ai-bridge": "node scripts/package-ai-bridge.mjs",
    "update:facebook-extension": "node scripts/update-installed-facebook-extension.mjs",
    "e2e:i37:extension": "node scripts/i37-extension-fixture-e2e.mjs",
    "test:e2e:i43-ocr": "playwright test --config=playwright.i43-real-ocr.config.ts",
    "dump:automation-traces": "node scripts/automation-trace-dump.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run src extensions/shared/product-extract.test.ts extensions/facebook/recorder.test.ts extensions/facebook/polling-schedule.test.ts extensions/facebook/extension-update.test.ts extensions/facebook/group-discovery.test.js extensions/facebook/supplier-capture-ui.test.js",
    "test:supabase-s3": "npx --yes deno test --allow-env --allow-read --allow-net --allow-sys supabase/functions/_shared/supabaseS3Storage.test.ts",
    "test:e2e": "playwright test --config=playwright.config.ts && playwright test --config=playwright.i43-real-ocr.config.ts",
    "verify": "npm run lint && npm test && npm run build && npm run check:no-secrets && npm run perf:check && npm audit",
    "backup:db": "node scripts/backup-db.mjs",
    "backup:storage": "node scripts/backup-storage.mjs",
    "backfill:product-thumbnails": "node scripts/backfill-product-thumbnails.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "perf:bundle": "node scripts/performance-report.mjs",
    "perf:check": "node scripts/performance-report.mjs --check",
    "perf:restock": "node --import tsx scripts/benchmark-restock.mjs",
    "test:facebook:concurrency": "node scripts/test-facebook-concurrency.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.475.0",
    "marked": "18.1.1",
    "motion": "^12.38.0",
    "pdfjs-dist": "4.10.38",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "7.0.0",
    "unpdf": "1.9.1",
    "wasm-feature-detect": "1.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@playwright/test": "^1.55.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "jsdom": "26.1.0",
    "standardwebhooks": "^1.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
