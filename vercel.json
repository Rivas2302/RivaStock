{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/catalogo/:slug/:productId",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i)(whatsapp|facebookexternalhit|meta-externalagent|instagram|twitterbot|linkedinbot)" } }],
      "destination": "/api/catalog-preview?slug=:slug&productId=:productId"
    },
    {
      "source": "/catalogo/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i)(whatsapp|facebookexternalhit|meta-externalagent|instagram|twitterbot|linkedinbot)" } }],
      "destination": "/api/catalog-preview?slug=:slug"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "routes": [
    {
      "src": "/p/(?<slug>[a-z0-9][a-z0-9-]{0,63})/(?<productId>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
      "dest": "https://nkfqhuqrgrpfufdymkcr.supabase.co/functions/v1/share?siteHost=rivastock.vercel.app&slug=$slug&productId=$productId",
      "transforms": [
        { "type": "response.headers", "op": "set", "target": { "key": "content-type" }, "args": "text/html; charset=utf-8" },
        { "type": "response.headers", "op": "delete", "target": { "key": "content-security-policy" } },
        { "type": "response.headers", "op": "set", "target": { "key": "content-security-policy" }, "args": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'" }
      ]
    },
    {
      "src": "/p/(?<slug>[a-z0-9][a-z0-9-]{0,63})",
      "dest": "https://nkfqhuqrgrpfufdymkcr.supabase.co/functions/v1/share?siteHost=rivastock.vercel.app&slug=$slug",
      "transforms": [
        { "type": "response.headers", "op": "set", "target": { "key": "content-type" }, "args": "text/html; charset=utf-8" },
        { "type": "response.headers", "op": "delete", "target": { "key": "content-security-policy" } },
        { "type": "response.headers", "op": "set", "target": { "key": "content-security-policy" }, "args": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'" }
      ]
    }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/p/:path*", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(), microphone=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' blob: https://formularios.viacargo.com.ar https://nkfqhuqrgrpfufdymkcr.supabase.co; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://nkfqhuqrgrpfufdymkcr.supabase.co wss://nkfqhuqrgrpfufdymkcr.supabase.co; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://nkfqhuqrgrpfufdymkcr.supabase.co"
    }
  }
}
