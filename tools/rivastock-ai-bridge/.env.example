AI_BRIDGE_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ai-bridge
# Copy these account-specific values from RivaStock > IA > Connect a PC.
AI_BRIDGE_TOKEN=replace-with-the-pairing-code-shown-once-in-rivastock
AI_BRIDGE_WORKER_ID=replace-with-the-device-id-shown-in-rivastock

# Real providers remain disabled until you explicitly enable them.
AI_BRIDGE_ENABLE_CODEX=false
AI_BRIDGE_ENABLE_CLAUDE=false

# Optional executable override. Use a .exe or other executable path, not a shell script.
CLAUDE_CLI_PATH=claude

# Optional override. Default: %USERPROFILE%\.rivastock-ai-bridge\codex
# AI_BRIDGE_CODEX_HOME=C:\Users\YOUR_USER\.rivastock-ai-bridge\codex

# Stable working directories used to resume persistent chats for each provider.
# Default: %USERPROFILE%\.rivastock-ai-bridge\sessions
# AI_BRIDGE_SESSION_DIR=C:\Users\YOUR_USER\.rivastock-ai-bridge\sessions

# Managed local mirror of Skills and knowledge files. Default: <RivaStock>/.rivastock-ai/workspace
# AI_BRIDGE_WORKSPACE_DIR=C:\Users\YOUR_USER\Desktop\IA\RivaStock\.rivastock-ai\workspace

# RivaStock project root used only for the curated read-only context checkbox.
# AI_BRIDGE_PROJECT_ROOT=C:\Users\YOUR_USER\Desktop\IA\RivaStock

# Claude Code uses this client-side cap for API-key accounts; estimates can exceed the cap.
AI_BRIDGE_CLAUDE_MAX_BUDGET_USD=1.00
